(class-name @tool StressTest)
(extends Node)
(signal health_changed)
(signal moved (old_pos new_pos))
(signal tagged ((tag String)))
(var plain)
(var typed int)
(var defaulted = 5)
(var inferred := 42)
(var full float = 0.5)
(var text String = '"packed double"')
(var direction Vector2 = "Vector2(1, 2)")
(var callback = (lambda (msg) (return msg)))
(static-var instance_count int = 0)
(static-var lazy := "\"hello\"")
(const max_lives = 3)
(const gravity float = 9.8)
(const inferred_const := "\"const-infer\"")
(var _health int = 100)
(var health int = 100
		(get
				(return _health))
		(set (value)
				(pass)))
(var "@export_range(0, 100)" max_hp int = 100)
(func "@rpc(\"any_peer\")" sync_hp (value) (assign _health = value))
(comment section: inner classes)
(class Item (extends RefCounted)
		(signal picked (item))
		(var label String = '"item"')
		(const kind = 1)
		(static-var total int = 0)
		(func describe ()
				(return label))
		(func use ()
				(const local_kind = 2)
				(if "local_kind > 0"
						(return true)
						(else
								(return false))))
		(class Detail
				(var depth int = 1)))
(comment section: flow control)
(func classify (x) (comment "classifier")
		(if "x > 0"
				(return 1)
				(elif "x == 0"
						(return 0))
				(elif "x == -1"
						(return -1))
				(else
						(return -99))))
(func loop_demo (items)
		(var total int = 0)
		(for item in items
				(if "item < 0"
						(continue))
				(if "item > 100"
						(break))
				(while "total < 0"
						(break)))
		(for n int in items
				(match "n"
						(branch "0"
								(return 0))
						(branch "1, 2"
								(return 1))
						(branch "[var a, var b]"
								(return a))
						(branch "{\"name\": var who}"
								(return who))
						(branch "_"
								(continue))))
		(return total))
(func make_adder ()
		(return (lambda (x) (comment "adder") (return x))))
(static-func version ()
		(return "\"1.0\""))
(func noop ()
		(pass))
(func convert (Variant ((amount float = 1.0) ...rest)) (return 1.0))
(static-func typed_id (int ((value))) (return 1))
(func sum_all (...nums) (pass))
(var counter int = 0)
(func bump (step)
		(assign counter += step)
		(call print counter)
		(return counter))
(func compute (x)
		(return (+ x (* 2 3))))
(func pick (a b)
		(return (and (== a b) (not debug_mode))))
(func negate (x)
		(return (- x)))
(func neg_sum (a b)
		(return (- (+ a b))))
(func find_first (items target)
		(for item in items
				(if (== item target)
						(return item)))
		(return -1))
(defmacro safe-call (obj mname ...args)
		(if (and obj (call (join obj ".has_method") (join "\"" mname "\"")))
				(call (join obj "." mname) ...args)))
(defmacro flag (n) (var (join "FLAG_" (upper n)) = true))
(func safe_greet (node)
		(safe-call node greet "\"hi\"")
		(pass))
(flag ready)
(for-generate (i (range 0 3))
		(var (join "slot_" i) int = 0))
(template-set enable_debug true)
(when enable_debug
		(func debug_dump ()
				(call print "\"debug\"")
				(pass)))
(var debug_mode = false)
(var inventory = (array 1 "\"sword\"" false))
(var stats = (dict-lua (hp 100) (name "\"hero\"")))
(var by_id = (dict-json ((call Vector2 1 2) 1)))
(var shelves = (array 1 (array 2 3) (dict-lua (a 1))))
(var app_name String = "\"app\"" (get get_app_name))
(func get_app_name ()
		(return app_name))
(enum (State) IDLE (RUNNING 1) STOPPED)
(func bit_ops (a b)
		(return (| (<< a 1) (& b 7))))
(func bit_not (v)
		(return (~ v)))
(func check_kind (x)
		(return (is x Node)))
(func has_item (arr x)
		(return (in x arr)))
(func wait_hp ()
		(await health_changed)
		(assert true)
		(breakpoint)
		(pass))
(func pick_or (c a b)
		(return (ternary c a b)))
(class @abstract Shape
		(func @abstract area (x)))
(comment multi atom join)
(comment `grave packed`)
(comment ´acute packed´)
(comment "a \"quoted\" word")
